# MC1 control config (R7-e): production's exact serve at ccf5fa7 (prod/pp4-a0, L2') on the experiment port 8001,
# through the same launcher as MC1-prod-prefix.env (offload/launch/serve_exp.sh, re-synced with production's serve.sh: chunk
# 8192, K5, PP4's fixed SPEC 5, threshold 1024, dual ring, CPU pin) and the launcher's own RECIPE_ENV, unchanged. It is M2b's control (C) arm:
# production's dsv41.env values and mounts exactly, NO MC1 overlay file, switch or transfer config. Generated by
# offload/prefixstore/make_configs.py from git show ccf5fa7:dsv41.env in the Sparks' deployed environment (GPU_CLOCK_CAP
# 2300: /etc/environment GPU_CLOCK_CAP=2300 on sparkhead and sparkworker-wired (NDM approved 2300, 2026-10-27; dsv41.env default 2150 overridden)); never edit.
for mc1_key in K1_KV_PAIR K1_DROP_MTP K1_TF_TRANSIENT K1_TF_ALIAS K1_INDEXER_FACTOR K1_KV_BYTES K1_MEMPROBE K1_NODROP SPEC_OVERRIDE EXP_EXTRA_ARGS OVERLAYS EXTRA_DOCKER_ARGS EXP_DOCKER_ENV KV_BYTES_OVERRIDE MAX_LEN_OVERRIDE RECIPE_ENV AK_MARGIN AK_MIN AK_HI AK_MAX_REQS ENGRAM GRAPH LOAD_FORMAT KERNEL_CONFIG VLLM_DISABLED_KERNELS; do
  if [ -n "${!mc1_key-}" ]; then echo "MC1 STOP: inherited $mc1_key" >&2; return 1; fi
done
[ "${GPU_CLOCK_CAP-}" = 2300 ] || { echo "MC1 STOP: GPU_CLOCK_CAP is not production's 2300" >&2; return 1; }
[ "${PROD_UPSTREAM_ALL-}" = e7e8e3f2dd57 ] || { echo "MC1 STOP: this checkout's dsv41.env is not production ccf5fa7's (upstream-all stage)" >&2; return 1; }
[ "${PROD_PP4-}" = 22897accecef ] || { echo "MC1 STOP: this checkout's dsv41.env is not production ccf5fa7's (PP4 stage)" >&2; return 1; }
unset mc1_key
LABEL=MC1-prod-control
KV_BYTES_OVERRIDE=6442450944
MAX_LEN_OVERRIDE=327680
EXP_DOCKER_ENV="PYTHONPATH=/root/.cache/dsv41-offload/offload/engram/spark/py DSV41_ENGRAM_OVERLAY=/root/.cache/dsv41-offload/offload/engram/spark/engram.py VLLM_ENGRAM_REMOTE_ROOT=/root/.cache/dsv41-offload VLLM_ENGRAM_REMOTE=rdma://10.202.28.1:18610@10.202.28.2,rdma://10.202.29.1:18610@10.202.29.2 VLLM_ENGRAM_REMOTE_TIMEOUT_MS=100 VLLM_ENGRAM_REMOTE_RETRY_MS=5000 VLLM_ENGRAM_REMOTE_REQUIRED=0 VLLM_ENGRAM_REMOTE_LOG_S=60 VLLM_DSV41_KV_PAIR=3 VLLM_DSV41_DROP_MTP_BUFFER=1 VLLM_EXL3_TF_PROMPT_TRANSIENT=1 VLLM_EXL3_TF_PROMPT_ALIAS=1 VLLM_INDEXER_PREFILL_BUFFER_FACTOR=4 VLLM_DSV41_INDEXER_DEFER=1 VLLM_DSV41_RELEASE_TOKENS=131072 VLLM_DSV41_REPLAY_SKIP=1 VLLM_DSV41_TOPK_FIX=1 VLLM_DSV41_TOPK_FIX_SO=/opt/dsv41-upfix/dsv41_topk.so VLLM_DSV41_VOR_FUSED=1 VLLM_EXL3_MOE_SPLIT_MAX_TOKENS=63 VLLM_DSPARK_REMOTE=o1rdma://10.202.28.1:18620 VLLM_DSPARK_REMOTE_BIND=10.202.28.2 VLLM_DSPARK_REMOTE_OFL_DIR=/opt/dsv41-ofl VLLM_DSPARK_REMOTE_POLICY=capacity VLLM_DSPARK_REMOTE_IDENTITY=be2c1436fa9f9e66b398e1b1da2e140e6fddc82a11939e2ac4240a0ca79543bd VLLM_DSPARK_REMOTE_MARKOV_IDENTITY=0b6e71e638abd5abce2db433965bb5ff523cbbe92ed7ae54324a50ccaeffa19a VLLM_DSPARK_REMOTE_TIMEOUT_MS=50 VLLM_DSPARK_REMOTE_ROUND_MS=28.79,31.86,34.44,37.76,41.56,43.68 VLLM_DSPARK_REMOTE_DRAFT_MS=4.4 VLLM_DSPARK_REMOTE_LOG_EVERY=1024 VLLM_DSPARK_REMOTE_BACKOFF_MAX_MS=5000 VLLM_DSPARK_REMOTE_ASYNC=1 VLLM_DSPARK_REMOTE_ASYNC_PROXY=process VLLM_DSPARK_REMOTE_ASYNC_SPIN_US=50 VLLM_DSPARK_REMOTE_ASYNC_NAP_US=20 VLLM_DSPARK_REMOTE_ASYNC_RESPAWNS=3 VLLM_DSPARK_REMOTE_ASYNC_RESPAWN_RESET_S=3600 VLLM_DSV41_ADAPTIVE_K=0 VLLM_DSPARK_DEPTH_POLICY=fixed:5 VLLM_DSPARK_DEPTH_FILE= VLLM_DSPARK_LOOKUP= VLLM_DSPARK_REMOTE_WANT_MARGIN=0 VLLM_DSPARK_SAMPLED_TOP32=1"
EXTRA_DOCKER_ARGS="-v \$HOME/dsv41-offload-prod/dspark/ofl:/opt/dsv41-ofl:ro -v \$HOME/dsv41-pp4/22897accecef/remote_dspark:/usr/local/lib/python3.12/dist-packages/vllm/v1/worker/gpu/spec_decode/remote_dspark:ro -v \$HOME/dsv41-offload-prod/dspark/spec_decode__init__.py:/usr/local/lib/python3.12/dist-packages/vllm/v1/worker/gpu/spec_decode/__init__.py:ro -v \$HOME/dsv41-kvpack/559c5867ba42/vllm/models/deepseek_v41/attention.py:/usr/local/lib/python3.12/dist-packages/vllm/models/deepseek_v41/attention.py:ro -v \$HOME/dsv41-kvpack/559c5867ba42/vllm/models/deepseek_v41/common/ops/fused_compress_quant_cache.py:/usr/local/lib/python3.12/dist-packages/vllm/models/deepseek_v41/common/ops/fused_compress_quant_cache.py:ro -v \$HOME/dsv41-kvpack/559c5867ba42/vllm/models/deepseek_v41/common/ops/nvfp4_fi_cache.py:/usr/local/lib/python3.12/dist-packages/vllm/models/deepseek_v41/common/ops/nvfp4_fi_cache.py:ro -v \$HOME/dsv41-kvpack/559c5867ba42/vllm/models/deepseek_v41/nvidia/dspark.py:/usr/local/lib/python3.12/dist-packages/vllm/models/deepseek_v41/nvidia/dspark.py:ro -v \$HOME/dsv41-kvpack/559c5867ba42/vllm/models/deepseek_v41/nvidia/flashinfer_sparse.py:/usr/local/lib/python3.12/dist-packages/vllm/models/deepseek_v41/nvidia/flashinfer_sparse.py:ro -v \$HOME/dsv41-kvpack/559c5867ba42/vllm/models/deepseek_v41/nvidia/model.py:/usr/local/lib/python3.12/dist-packages/vllm/models/deepseek_v41/nvidia/model.py:ro -v \$HOME/dsv41-kvpack/559c5867ba42/vllm/v1/core/kv_cache_utils.py:/usr/local/lib/python3.12/dist-packages/vllm/v1/core/kv_cache_utils.py:ro -v \$HOME/dsv41-kvpack/559c5867ba42/vllm/v1/kv_cache_interface.py:/usr/local/lib/python3.12/dist-packages/vllm/v1/kv_cache_interface.py:ro -v \$HOME/dsv41-kvpack/559c5867ba42/vllm/v1/worker/utils.py:/usr/local/lib/python3.12/dist-packages/vllm/v1/worker/utils.py:ro -v \$HOME/dsv41-pp4/22897accecef/dist/vllm/v1/worker/gpu/model_runner.py:/usr/local/lib/python3.12/dist-packages/vllm/v1/worker/gpu/model_runner.py:ro -v \$HOME/dsv41-kvpack/