# Delta for the historical D environment, not a complete launcher configuration.
# Append these variables to the persistent drafter environment passed to BOTH ranks.
# Build the helper and stage the complete matching process-proxy package first.
# Replace the helper path to match the read-only transport mount in your deployment.
VLLM_DSPARK_REMOTE_ASYNC=1
VLLM_DSPARK_REMOTE_ASYNC_PROXY=process
VLLM_DSPARK_REMOTE_ASYNC_SPIN_US=50
VLLM_DSPARK_REMOTE_ASYNC_NAP_US=20
VLLM_DSPARK_REMOTE_ASYNC_RESPAWNS=3
VLLM_DSPARK_REMOTE_ASYNC_RESPAWN_RESET_S=3600
VLLM_DSPARK_REMOTE_HOSTFLAG_LIB=/opt/dsv41-ofl/libdsv41_hostflag.so
# Leave CUDA_MODULE_LOADING at its default. Preserve endpoint, identities,
# capacity policy, timeout, backoff cap, KV and the historical calibrated cost table.
# That cost table has not been refitted for the two-card async path.
# Rollback: remove VLLM_DSPARK_REMOTE_ASYNC from the persistent environment and restart.
