# Historical synchronous configuration. Apply production-async.env.example separately for the documented async setting.
# Historical configuration "D-kv6" (sanitized). Replace every <...>. These variables are read by the serve script and
# passed into the vLLM container on both Spark ranks; see each optimization's entry for the full procedure.

# --- base serve (stock two-Spark recipe, image ghcr.io/henryous/deepseek-v41-1017-dgx-spark:v5) ---
MODEL_DIR=/srv/dsv41/model                 # EXL3 2.75 bpw build; Engram shards 47/48 from deepseek-ai/DeepSeek-V4.1-Flash-1017
MAX_LEN=327680                             # model supports 1,048,576 (1M validation in progress)
MAX_SEQS=4
MAX_BATCH=4096
SPEC='{"method":"dspark","num_speculative_tokens":5,"num_speculative_tokens_per_batch_size":[[1,2,5],[3,4,4]]}'

# --- B: remote Engram (entry dsv41-remote-engram-rdma) ---
OFFLOAD_DOCKER_ENV="PYTHONPATH=<staged>/engram/spark/py DSV41_ENGRAM_OVERLAY=<staged>/engram/spark/engram.py \
VLLM_ENGRAM_REMOTE_ROOT=<staged> VLLM_ENGRAM_REMOTE=rdma://<host-ip-link-a>:<engram-port>@<spark-a-link-ip>,rdma://<host-ip-link-b>:<engram-port>@<spark-b-link-ip> \
VLLM_ENGRAM_REMOTE_TIMEOUT_MS=100 VLLM_ENGRAM_REMOTE_RETRY_MS=5000 VLLM_ENGRAM_REMOTE_REQUIRED=0 VLLM_ENGRAM_REMOTE_LOG_S=60"

# --- D: remote DSpark drafter in capacity mode (entry dsv41-remote-dspark-drafter-3090) ---
OFFLOAD_DSPARK_ENV="VLLM_DSPARK_REMOTE=o1rdma://<host-ip-link-a>:<drafter-port> VLLM_DSPARK_REMOTE_BIND=<spark-a-link-ip> \
VLLM_DSPARK_REMOTE_OFL_DIR=/opt/dsv41-ofl VLLM_DSPARK_REMOTE_POLICY=capacity \
VLLM_DSPARK_REMOTE_IDENTITY=<drafter sha256 identity> VLLM_DSPARK_REMOTE_MARKOV_IDENTITY=<markov sha256 identity> \
VLLM_DSPARK_REMOTE_TIMEOUT_MS=50 VLLM_DSPARK_REMOTE_ROUND_MS=28.79,31.86,34.44,37.76,41.56,43.68 VLLM_DSPARK_REMOTE_DRAFT_MS=4.4 \
VLLM_DSPARK_REMOTE_LOG_EVERY=1024 VLLM_DSPARK_REMOTE_BACKOFF_MAX_MS=5000"
# read-only bind mounts of the staged overlay and transport into the container
OFFLOAD_DOCKER_ARGS="-v <staged>/dspark/ofl:/opt/dsv41-ofl:ro \
-v <staged>/dspark/remote_dspark:/usr/local/lib/python3.12/dist-packages/vllm/v1/worker/gpu/spec_decode/remote_dspark:ro \
-v <staged>/dspark/spec_decode__init__.py:/usr/local/lib/python3.12/dist-packages/vllm/v1/worker/gpu/spec_decode/__init__.py:ro"
# the drafter's freed memory spent on KV: 6.0 GiB per rank (stock 4026531840 = 3.75 GiB)
PROD_KV_BYTES=6442450944

# Rollback to B: remove the D-specific settings above (OFFLOAD_DSPARK_ENV, OFFLOAD_DOCKER_ARGS, PROD_KV_BYTES) and restart.
# Rollback to the stock recipe: also comment out OFFLOAD_DOCKER_ENV.
